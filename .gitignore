.pio/

# Three machines (laptop, office, workshop) share this repo through GitHub, so
# anything machine-specific must stay out and anything that should match on all
# three must stay in.
#
# Note the trailing /* rather than /: git cannot re-include a file whose parent
# directory is excluded, so ignoring ".vscode/" outright would make the negation
# below silently do nothing.
.vscode/*
!.vscode/extensions.json

# Generated by PlatformIO and consumed by clangd for C/C++ intellisense. Full of
# absolute paths and tied to whichever env was built last, so each machine wants
# its own rather than a shared one.
compile_commands.json
